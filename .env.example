# Client-exposed. Safe for the browser (used for direct Supabase Realtime
# subscriptions). Get these from Supabase Dashboard > Project Settings > API.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never expose to the client, never commit a real value.
NUXT_SUPABASE_SERVICE_ROLE_KEY=
